<Window x:Class="DesktopHub.App.Pill.PillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:eb="clr-namespace:DesktopHub.App.EmotionBall"
        Title="DesktopHub"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        BorderBrush="{x:Null}"
        BorderThickness="0"
        ShowInTaskbar="False"
        ShowActivated="False"
        Width="240" Height="58"
        ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 玻璃拟态自动隐藏滚动条:默认透明,悬停面板淡入、离开淡出;滑块随悬停/拖拽提亮 -->
        <Style x:Key="GlassScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="32">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder" Background="#26FFFFFF" CornerRadius="1" Margin="1,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#66FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#99FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 覆盖式滚动容器:内容铺满整宽,滚动条悬浮贴右侧;像素级平滑滚轮 -->
        <Style x:Key="GlassScrollViewer" TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="CanContentScroll" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    CanHorizontallyScroll="False" CanVerticallyScroll="False"
                                                    Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" Style="{StaticResource GlassScrollBar}" Orientation="Vertical"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,4,2,4" Cursor="Arrow"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 玻璃拟态背景(按 OS 分支,详见 AcrylicHelper):
         Win11:layered + SetWindowCompositionAttribute(ACCENT_ENABLE_ACRYLICBLURBEHIND)+
             DWMWA_SYSTEM_BACKDROP_TYPE=TRANSIENTWINDOW(DWM 系统 Acrylic);SetWindowRgn 裁圆角。
         Win10(含 22H2):layered + SetWindowCompositionAttribute(ACCENT_ENABLE_BLURBEHIND)
             —— DWM 按 SetWindowRgn 区域模糊,无矩形 surface / 边缘描边;tint 由下方 TintOverlay
             以 AcrylicOpacity 自绘(旧 AccentState=4 亚克力在 Win10 自带 1px 矩形外框,已弃用)。
         内容层保留 1px 半透明白色高光描边(CapsuleStrokeBrush)+ 极轻衬底。 -->
    <Border x:Name="PillBorder"
            Background="Transparent"
            BorderBrush="{DynamicResource CapsuleStrokeBrush}"
            BorderThickness="1"
            CornerRadius="29">
        <Grid>
            <!-- 极轻衬底:叠在亚克力之上、内容之下,只作冷暖微调(Alpha ≤ 0x40),
                 真正的模糊与着色由 DWM Accent(GradientColor)承担。
                 settings 后续可让用户切换"无 tint / 浅色 tint / 深色 tint"。 -->
            <Border x:Name="TintOverlay" IsHitTestVisible="False"
                    Background="{DynamicResource CapsuleTintBrush}"
                    CornerRadius="{Binding CornerRadius, ElementName=PillBorder}"/>

            <!-- 胶囊本体(时间) + 右侧最近打开扩展条:悬停时整体向右展开 -->
            <Grid x:Name="CapsuleBar" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                <Grid.Effect>
                    <!-- 底部"悬浮"投影:Direction=90 朝下,ShadowDepth=2 把暗晕压到胶囊下沿 ~6px,
                         PillBorder.Clip 虽会裁掉外凸部分,但下半边留出渐暗的"内悬浮"效果 -->
                    <DropShadowEffect Color="Black" BlurRadius="22" Opacity="0.32"
                                      ShadowDepth="2" Direction="90"/>
                </Grid.Effect>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 小胶囊态:表情球 + 当前时间。
                     整列透明背景扩大可点击区。布局:球贴左(灵动岛式),时间相对整窗水平居中
                     (TextBlock HorizontalAlignment=Center 于 240px → 中心 120,而非右侧剩余空间居中)。
-->                <Grid x:Name="SmallPanel" Grid.Column="0" Background="Transparent"
                      Cursor="Hand" MouseLeftButtonDown="Capsule_MouseDown">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="SmallShift"/>
                    </Grid.RenderTransform>
                    <!-- 表情球:贴左(留 4px 与左弧协调),点击自旋一圈(阻止冒泡,不触发胶囊展开) -->
                    <Border Width="44" Height="44" Margin="4,0,0,0"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="Transparent" Cursor="Hand"
                            MouseLeftButtonDown="EmotionBall_MouseDown">
                        <eb:EmotionBallControl x:Name="EmotionBall"/>
                    </Border>
                    <!-- 时间:单独居中于整个胶囊(中心 x=120) -->
                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" FontSize="21" FontWeight="Medium"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="{Binding TimeText}"/>
                </Grid>

                <!-- 悬停扩展条:最近打开的 3 个软件 -->
                <StackPanel x:Name="RecentPanel" Grid.Column="1"
                            Visibility="Collapsed" Opacity="0"
                            Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left"
                            Cursor="Hand" MouseLeftButtonDown="Capsule_MouseDown">
                    <Border Width="1" Height="30" Background="#33FFFFFF" Margin="2,0,12,0"/>
                    <ItemsControl ItemsSource="{Binding RecentApps}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="44" Height="44" Margin="4,0" CornerRadius="10" Padding="4"
                                        Background="Transparent" Cursor="Hand"
                                        MouseLeftButtonDown="RecentTile_MouseDown"
                                        ToolTip="{Binding ToolTip}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#22FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Image Source="{Binding Icon}" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="暂无最近打开" Foreground="#9A9AA8" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRecent}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- 音乐前置区:滚轮上滑/播放开始时替换 前置区(表情球+时间),滚轮下滑切回。
                     必须留在 CapsuleBar 第 0 列(固定 240 宽):播放/暂停锚在胶囊右缘,
                     悬停展开"最近打开"时不随窗口拉宽而右移;放外层 Grid 会横跨全窗宽,按钮跟着跑。
                     有会话:圆形封面(40) + 歌名/歌手 + 播放/暂停;无会话:音符 + 「暂无音乐」占位。
                     MusicShift 供滚轮上/下滑的轮换动画做竖直位移。 -->
                <Grid x:Name="MusicFrontPanel" Grid.Column="0" Background="Transparent"
                      Visibility="Collapsed" Opacity="0" Cursor="Hand" MouseLeftButtonDown="Capsule_MouseDown">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="MusicShift"/>
                    </Grid.RenderTransform>
                    <!-- 有媒体会话:封面 + 歌名/歌手 + 播放/暂停(歌名右侧) -->
                    <Grid Margin="7,0,6,0" Visibility="{Binding HasNowPlaying, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 专辑封面:40 圆形(与表情球同位),无封面显示音符。
                             Image + 椭圆 Clip:ImageBrush(Freezable)上的绑定在属性由 null 变非 null 时不更新,勿用。 -->
                        <Grid Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center">
                            <Path Style="{StaticResource PillIcon}" Data="{StaticResource IconMusic}"
                                  Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding NowPlayingArtwork}" Stretch="UniformToFill"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image.Clip>
                                    <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20"/>
                                </Image.Clip>
                            </Image>
                            <Ellipse Stroke="{DynamicResource CapsuleStrokeBrush}" StrokeThickness="1"/>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="9,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding NowPlayingTitle}" FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding NowPlayingArtist}" FontSize="10.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource PillIconButton}" VerticalAlignment="Center"
                                Command="{Binding TogglePlayPauseCommand}" ToolTip="播放/暂停">
                            <Grid>
                                <Path Data="{StaticResource IconPause}">
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource PillIconFill}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMusicPlaying}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <Path Data="{StaticResource IconPlay}">
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource PillIconFill}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMusicPlaying}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- 无媒体会话:暂无音乐占位 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNowPlaying}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Path Style="{StaticResource PillIcon}" Data="{StaticResource IconMusic}"
                              Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="暂无音乐" FontSize="12" Margin="10,0,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>

                <!-- 展开态:按分类分组的桌面图标面板(固定尺寸覆盖层,动画期间内容不重排) -->
            <Grid x:Name="ExpandedPanel" Width="600" Height="552"
                  HorizontalAlignment="Left" VerticalAlignment="Top"
                  Margin="20,16,20,12" Opacity="0" Visibility="Hidden">
                <Grid.Effect>
                    <!-- 展开面板四周柔光晕:Direction=90 朝下为主,BlurRadius 大让暗晕铺到面板下沿与底部 -->
                    <DropShadowEffect Color="Black" BlurRadius="22" Opacity="0.18"
                                      ShadowDepth="4" Direction="90"/>
                </Grid.Effect>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 头部:标题 + 刷新 / 隐藏图标 / 设置(SVG 矢量图标按钮,标签转为 ToolTip) -->
                <DockPanel Grid.Row="0" LastChildFill="False">
                    <TextBlock Text="DesktopHub" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="RefreshButton" Style="{StaticResource PillIconButton}" Command="{Binding RefreshCommand}"
                                ToolTip="{Binding RefreshLabel}" Click="RefreshButton_Click">
                            <Path x:Name="RefreshIcon" Style="{StaticResource PillIcon}" Data="{StaticResource IconRefresh}"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform/>
                                </Path.RenderTransform>
                            </Path>
                        </Button>
                        <Button x:Name="ToggleIconsButton" Style="{StaticResource PillIconButton}" Command="{Binding ToggleIconsCommand}"
                                ToolTip="{Binding ToggleLabel}" Margin="2,0,0,0">
                            <Grid>
                                <!-- 桌面图标可见:睁眼 -->
                                <Path Data="{StaticResource IconEye}">
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource PillIcon}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DesktopIconsHidden}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <!-- 桌面图标已隐藏:闭眼斜杠 -->
                                <Path Data="{StaticResource IconEyeOff}">
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource PillIcon}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DesktopIconsHidden}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource PillIconButton}" Command="{Binding ShowSettingsCommand}"
                                ToolTip="设置" Margin="2,0,0,0" Click="SettingsButton_Click">
                            <Path Style="{StaticResource PillIcon}" Data="{StaticResource IconSettings}"/>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- 分组图标列表 -->
                <ScrollViewer Grid.Row="1" Style="{StaticResource GlassScrollViewer}" Margin="0,12,0,0" Padding="0,0,8,0">
                    <ItemsControl x:Name="GroupsList" ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2,0,10">
                                    <TextBlock Text="{Binding Name}" Foreground="#9A9AA8" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding Icons}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="84" Height="76" Margin="2" CornerRadius="8" Padding="4"
                                                        Background="Transparent" Cursor="Hand"
                                                        MouseLeftButtonDown="Tile_MouseDown"
                                                        ToolTip="{Binding ToolTip}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#22FFFFFF"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel VerticalAlignment="Top">
                                                        <Image Source="{Binding Icon}" Width="32" Height="32" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11"
                                                                   HorizontalAlignment="Center" TextAlignment="Center"
                                                                   TextWrapping="Wrap" MaxHeight="30" TextTrimming="CharacterEllipsis"
                                                                   Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
